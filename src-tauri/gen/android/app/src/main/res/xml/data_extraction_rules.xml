<?xml version="1.0" encoding="utf-8"?>
<!-- RUN-A07: Noid stores identity keys, encrypted DB and Tor material under
     app-private storage — none of it may leave the device via cloud backup
     or device-to-device transfer. Excluding everything is the safe rule. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
